<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Slide" Manufacturer="JeongEEE" Version="$(var.Version)" UpgradeCode="1254CE28-A4BC-4E31-BA0A-DC5D959DA341" Scope="perUserOrMachine" Compressed="yes" Language="1042" Codepage="949">
    <SummaryInformation Codepage="949" Description="Slide 프레젠테이션 편집기" Manufacturer="JeongEEE" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="더 최신 버전의 Slide가 이미 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeckcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeckcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/JeongEEE/deckcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/JeongEEE/deckcraft" />
    <Property Id="ARPHELPLINK" Value="https://github.com/JeongEEE/deckcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="JeongEEE">
        <Directory Id="INSTALLFOLDER" Name="Slide" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Slide" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="DeckcraftFiles" />
    </Feature>
    <!-- The finish page offers to launch Slide (ticked by default) through WixShellExec
         (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Slide 실행" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#DeckcraftExe]" />
    <CustomAction Id="LaunchSlide" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSlide" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="DeckcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="DeckcraftApp" Guid="CCE82C65-C471-42C0-98B6-F67F5A92D6A3">
        <File Id="DeckcraftNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="DeckcraftExe" Source="$(var.BinDir)\slide.exe" KeyPath="yes">
          <!-- No Icon here, so the shortcut shows the icon embedded in slide.exe (build.rs). An
               MSI Icon is cached under %APPDATA%\Microsoft\Installer\{ProductCode}\, and every
               update is a major upgrade with a new ProductCode that deletes the old folder. A
               taskbar pin is a copy of this shortcut that the update never touches, so it kept
               pointing at the deleted file and lost its icon (#1114). The exe's path survives
               updates; the shortcut is not advertised, so it targets that path and its icon is the
               exe's own. The Icon above stays for ARPPRODUCTICON (Apps and features). -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Slide (JeongEEE)" Description="Slide 프레젠테이션 편집기" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>

        <!-- .deckcraft: DeckCraft's own format, an "Open with" candidate only. No <Extension>: it
             would set the extension's default app and take .deckcraft over from an installed DeckCraft. -->
        <ProgId Id="JeongEEE.Slide.Presentation" Description="DeckCraft Presentation" Icon="DeckcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\JeongEEE.Slide.Presentation\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.deckcraft\OpenWithProgids" Name="JeongEEE.Slide.Presentation" Value="" Type="string" />

        <!-- "Open with" for PowerPoint formats, without becoming the default. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe" Name="FriendlyAppName" Value="Slide" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe\shell\open\command" Value="&quot;[#DeckcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\slide.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="JeongEEE.Slide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.potx\OpenWithProgids" Name="JeongEEE.Slide.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppsx\OpenWithProgids" Name="JeongEEE.Slide.Presentation" Value="" Type="string" />

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\slide.exe" Value="[#DeckcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\JeongEEE\Slide" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="DeckcraftCli">
        <File Id="DeckcraftCliExe" Source="$(var.BinDir)\slide-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
